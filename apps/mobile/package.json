{
  "name": "@bytedepth/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "~58.0.17",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.10",
    "expo-network": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "1.61.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "9.39.1",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-expo": "~58.0.12",
    "jsdom": "26.1.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "npm run android:build --",
    "ios": "cd ../.. && python3 -m tools.bytedepth mobile run -- npm exec --no -- expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint . --max-warnings=0",
    "android:build": "cd ../.. && python3 -m tools.bytedepth mobile run -- npm exec --no -- expo run:android --variant debug",
    "prebuild:android": "cd ../.. && python3 -m tools.bytedepth mobile run -- npm exec --no -- expo prebuild --platform android --no-install"
  },
  "private": true,
  "engines": {
    "node": "22.22.1"
  }
}
