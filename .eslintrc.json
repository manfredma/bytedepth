{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "globals": {
    "Vditor": "readonly"
  },
  "overrides": [
    {
      "files": ["**/src/test/js/**/*.test.js"],
      "env": {
        "jest": true,
        "node": true
      },
      "rules": {
        "no-eval": "off"
      }
    }
  ],
  "rules": {
    "no-var": "warn",
    "prefer-const": "warn",
    "no-console": "warn",
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-undef": "error",
    "eqeqeq": ["error", "always"],
    "curly": "warn",
    "no-eval": "error"
  }
}
