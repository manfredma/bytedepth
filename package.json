{
  "name": "bytedepth-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "ByteDepth 前端脚本与测试",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint bytedepth-start/src/main/resources/static/js/ tests/ playwright.config.mjs",
    "test:e2e": "env -u NO_COLOR playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/src/test/js/**/*.test.js"
    ]
  }
}
