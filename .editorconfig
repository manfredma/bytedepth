root = true

# Repository-wide text encoding, line endings, indentation and whitespace
# baseline. Tool-specific formatting remains in .prettierrc.json and pom.xml.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,css,scss,html,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_size = 2
