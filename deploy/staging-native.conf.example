# Staging-only parallel runtime. These ports and paths must not overlap Docker.
BYTEDEPTH_NATIVE_STACK_MODE=parallel
BYTEDEPTH_NATIVE_ROOT=/data/bytedepth-native-staging
BYTEDEPTH_NATIVE_MYSQL_PORT=13306
BYTEDEPTH_NATIVE_REDIS_PORT=16379
BYTEDEPTH_NATIVE_MEILI_PORT=17700
BYTEDEPTH_NATIVE_APP_PORT=18080
BYTEDEPTH_NATIVE_EDGE_PORT=18081
