# Public staging ingress for the host-native isolated stack.
# This file is rendered into /etc/nginx/conf.d/bytedepth-staging.conf.
# The internal native edge listens on __NATIVE_EDGE_PORT__; this public
# listener owns the DNS-facing 80/443 sockets and the staging certificate.

server {
    listen 80;
    server_name __BYTEDEPTH_DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name __BYTEDEPTH_DOMAIN__;

    if ($host != __BYTEDEPTH_DOMAIN__) {
        return 444;
    }

    ssl_certificate /etc/letsencrypt/live/__BYTEDEPTH_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__BYTEDEPTH_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 10m;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Referrer-Policy "no-referrer" always;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location = /feed.xml {
        return 404;
    }

    location = /sitemap.xml {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:__NATIVE_EDGE_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
