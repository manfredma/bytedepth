# staging server 配置（由 envsubst 处理 ${BYTEDEPTH_DOMAIN}）。
# 此文件被 include 在 http{} 内（由 staging-root.conf 的 http 块引入），
# 因此只含 server 块，不能有 events/http 块。
# resolver 在 staging-root.conf 的 http 块中已声明。

# HTTP -> HTTPS 跳转（仅 staging 域名）
server {
    listen 80;
    server_name ${BYTEDEPTH_DOMAIN};
    return 301 https://$host$request_uri;
}

# IP 地址直接 HTTP 访问（不做 HTTPS 跳转）
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

# HTTPS
server {
    listen 443 ssl;
    server_name ${BYTEDEPTH_DOMAIN};

    # If this file is selected as a shared-listener fallback, never proxy an
    # unknown Host or direct-IP request into the staging application.
    if ($host != ${BYTEDEPTH_DOMAIN}) {
        return 444;
    }

    ssl_certificate /etc/letsencrypt/live/${BYTEDEPTH_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BYTEDEPTH_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    client_max_body_size 10m;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Referrer-Policy "no-referrer" always;

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location = /feed.xml {
        return 404;
    }

    location = /sitemap.xml {
        return 404;
    }

    location / {
        set $app_upstream bytedepth-app:8080;
        proxy_pass http://$app_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
