[Unit]
Description=ByteDepth production green Redis
After=local-fs.target network.target
Before=bytedepth-production-green-app.service

[Service]
Type=notify
User=redis
Group=redis
ExecStart=/usr/bin/redis-server __GREEN_ROOT__/redis/redis.conf
ExecStop=/usr/bin/redis-cli -h 127.0.0.1 -p __REDIS_PORT__ shutdown
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
LimitNOFILE=65536
MemoryMax=128M
ReadWritePaths=__GREEN_ROOT__/redis
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
