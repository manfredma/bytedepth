[Unit]
Description=ByteDepth isolated staging native MySQL
After=local-fs.target network.target
Before=bytedepth-staging-native-app.service

[Service]
Type=simple
User=mysql
Group=mysql
ExecStart=/usr/sbin/mysqld --datadir=__NATIVE_ROOT__/mysql --bind-address=127.0.0.1 --port=__MYSQL_PORT__ --socket=/run/bytedepth-staging-native/mysql.sock --pid-file=/run/bytedepth-staging-native/mysql.pid --log-error=__NATIVE_ROOT__/mysql/error.log --lower-case-table-names=1
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=60s
LimitNOFILE=65536
MemoryMax=384M
RuntimeDirectory=bytedepth-staging-native
RuntimeDirectoryMode=0750
ReadWritePaths=__NATIVE_ROOT__/mysql
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
