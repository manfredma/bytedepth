[Unit]
Description=ByteDepth Redis data service
After=local-fs.target network.target
Before=bytedepth-app.service

[Service]
Type=notify
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/redis/redis.conf --bind 127.0.0.1 --port 6379 --dir /data/redis
ExecStop=/usr/bin/redis-cli -h 127.0.0.1 -p 6379 shutdown
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
LimitNOFILE=65536
ReadWritePaths=/data/redis
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
