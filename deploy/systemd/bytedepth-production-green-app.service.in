[Unit]
Description=ByteDepth production green application
Requires=bytedepth-production-green-mysql.service bytedepth-production-green-redis.service bytedepth-production-green-meilisearch.service
After=network-online.target bytedepth-production-green-mysql.service bytedepth-production-green-redis.service bytedepth-production-green-meilisearch.service
Wants=network-online.target
RequiresMountsFor=__GREEN_ROOT__/images

[Service]
Type=simple
User=bytedepth
Group=bytedepth
WorkingDirectory=/opt/bytedepth/production-green/current
Environment=JAVA_HOME=__JAVA_HOME__
EnvironmentFile=/etc/bytedepth/production-green.env
ExecStart=__JAVA_BIN__ -XX:MaxRAMPercentage=65 -jar /opt/bytedepth/production-green/current/app.jar
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=30s
LimitNOFILE=65536
MemoryMax=768M
ReadWritePaths=__GREEN_ROOT__/images
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
