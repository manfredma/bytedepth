[Unit]
Description=ByteDepth production production edge
After=bytedepth-production-app.service network-online.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=__PRODUCTION_ROOT__/edge/nginx.pid
User=ubuntu
Group=ubuntu
ExecStartPre=/usr/sbin/nginx -t -c /etc/bytedepth/production-nginx.conf
ExecStartPre=/usr/bin/curl --fail --silent --show-error --retry 12 --retry-delay 2 --retry-connrefused http://127.0.0.1:__APP_PORT__/version
ExecStart=/usr/sbin/nginx -c /etc/bytedepth/production-nginx.conf -g 'daemon on; master_process on;'
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -QUIT $MAINPID
Restart=on-failure
RestartSec=5s
PrivateTmp=true
MemoryMax=64M

[Install]
WantedBy=multi-user.target
