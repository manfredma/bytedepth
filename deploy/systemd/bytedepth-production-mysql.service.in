[Unit]
Description=ByteDepth production MySQL
After=local-fs.target network.target
Before=bytedepth-production-app.service

[Service]
Type=simple
User=mysql
Group=mysql
ExecStart=/usr/sbin/mysqld --datadir=__PRODUCTION_ROOT__/mysql --bind-address=127.0.0.1 --port=__MYSQL_PORT__ --socket=/run/bytedepth-production/mysql.sock --pid-file=/run/bytedepth-production/mysql.pid --log-error=__PRODUCTION_ROOT__/mysql/error.log --lower-case-table-names=1
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=60s
LimitNOFILE=65536
MemoryMax=512M
RuntimeDirectory=bytedepth-production
RuntimeDirectoryMode=0750
ReadWritePaths=__PRODUCTION_ROOT__/mysql
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
