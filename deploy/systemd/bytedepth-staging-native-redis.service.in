[Unit]
Description=ByteDepth isolated staging native Redis
After=local-fs.target network.target
Before=bytedepth-staging-native-app.service

[Service]
Type=notify
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/bytedepth/staging-native-redis.conf
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
LimitNOFILE=65536
ReadWritePaths=__NATIVE_ROOT__/redis
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
