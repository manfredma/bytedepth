[Unit]
Description=bytedepth isolated staging E2E test slot
After=network-online.target
Wants=network-online.target
Conflicts=bytedepth-app.service
Before=bytedepth-app.service
RequiresMountsFor=/data/images
ConditionPathExists=/run/bytedepth/staging-e2e.env
ConditionPathExists=/opt/bytedepth/current/app.jar

[Service]
Type=simple
User=bytedepth
Group=bytedepth
EnvironmentFile=/run/bytedepth/staging-e2e.env
WorkingDirectory=/opt/bytedepth/current
ExecStartPre=/bin/sh -c '! /bin/systemctl is-active --quiet bytedepth-app.service'
ExecStartPre=/usr/bin/test -r ${BYTEDEPTH_TEST_SLOT_JAR}
ExecStartPre=/usr/bin/test -n ${BYTEDEPTH_TEST_SLOT_SHA256}
ExecStart=/usr/lib/jvm/java-25-openjdk-amd64/bin/java -jar ${BYTEDEPTH_TEST_SLOT_JAR}
Restart=on-failure
RestartSec=3s
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data/images-test /run/bytedepth
MemoryMax=768M
TasksMax=256

[Install]
WantedBy=multi-user.target
