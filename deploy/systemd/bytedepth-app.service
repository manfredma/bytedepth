[Unit]
Description=ByteDepth Spring Boot application
Requires=mysql.service redis.service meilisearch.service
After=network-online.target mysql.service redis.service meilisearch.service
Wants=network-online.target
RequiresMountsFor=/data/images

[Service]
Type=simple
User=bytedepth
Group=bytedepth
WorkingDirectory=/opt/bytedepth/current
Environment=JAVA_HOME=/usr/lib/jvm/java-25-openjdk
EnvironmentFile=-/etc/bytedepth/application-production.env
EnvironmentFile=-/etc/bytedepth/application.env
ExecStart=/usr/lib/jvm/java-25-openjdk/bin/java -XX:MaxRAMPercentage=65 -jar /opt/bytedepth/current/app.jar
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=30s
LimitNOFILE=65536
MemoryMax=768M
ReadWritePaths=/data/images
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
