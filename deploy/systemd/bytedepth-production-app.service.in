[Unit]
Description=ByteDepth production production application
Requires=bytedepth-production-mysql.service bytedepth-production-redis.service bytedepth-production-meilisearch.service
After=network-online.target bytedepth-production-mysql.service bytedepth-production-redis.service bytedepth-production-meilisearch.service
Wants=network-online.target
RequiresMountsFor=__PRODUCTION_ROOT__/images

[Service]
Type=simple
User=bytedepth
Group=bytedepth
WorkingDirectory=/opt/bytedepth/production/current
Environment=JAVA_HOME=__JAVA_HOME__
EnvironmentFile=/etc/bytedepth/production.env
ExecStart=__JAVA_BIN__ -XX:MaxRAMPercentage=65 -jar /opt/bytedepth/production/current/app.jar
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=30s
LimitNOFILE=65536
MemoryMax=768M
ReadWritePaths=__PRODUCTION_ROOT__/images
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
