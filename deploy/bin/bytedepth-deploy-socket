#!/usr/bin/env bash
set -Eeuo pipefail

readonly STATE_DIR=/var/lib/bytedepth-deploy
readonly STATE_FILE="$STATE_DIR/status"
readonly JOB_UNIT=bytedepth-deploy-job.service

print_status() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        printf 'state=IDLE\nupdated_at=\nversion=\ncommit=\n'
    fi
}

read -r request || exit 0
case "$request" in
    status)
        print_status
        ;;
    deploy-tag\ *)
        release_tag="${request#deploy-tag }"
        if [[ ! "$release_tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
            printf 'state=REJECTED\nupdated_at=\nversion=\ncommit=\n'
            exit 0
        fi
        if systemctl is-active --quiet "$JOB_UNIT"; then
            printf 'state=BUSY\nupdated_at=\nversion=\ncommit=\n'
        elif systemd-run --unit="$JOB_UNIT" --collect --no-block \
            --setenv="BYTEDEPTH_RELEASE_TAG=$release_tag" \
            /usr/local/lib/bytedepth-deploy/bytedepth-deploy-job >/dev/null; then
            printf 'state=QUEUED\nupdated_at=%s\nversion=%s\ncommit=\n' "$(date -u +%FT%TZ)" "$release_tag"
        else
            printf 'state=REJECTED\nupdated_at=\nversion=\ncommit=\n'
        fi
        ;;
    *)
        printf 'state=REJECTED\nupdated_at=\nversion=\ncommit=\n'
        ;;
esac
