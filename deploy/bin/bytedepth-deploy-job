#!/usr/bin/env bash
set -Eeuo pipefail

readonly DEPLOY_ROOT=/opt/bytedepth
readonly STATE_DIR=/var/lib/bytedepth-deploy
readonly STATE_FILE="$STATE_DIR/status"
readonly LOG_FILE=/var/log/bytedepth-deploy.log
readonly CONFIG_FILE=/etc/bytedepth-deploy.conf

write_state() {
    local state="$1"
    local commit="$2"
    local temporary
    mkdir -p "$STATE_DIR"
    temporary="$(mktemp "$STATE_DIR/status.XXXXXX")"
    printf 'state=%s\nupdated_at=%s\ncommit=%s\n' \
        "$state" "$(date -u +%FT%TZ)" "$commit" > "$temporary"
    chmod 0600 "$temporary"
    mv "$temporary" "$STATE_FILE"
}

mkdir -p "$STATE_DIR"
touch "$LOG_FILE"
exec >> "$LOG_FILE" 2>&1

cd "$DEPLOY_ROOT"
current_commit="$(git rev-parse --short HEAD)"
current_branch="$(git branch --show-current)"
if [[ "$current_branch" != "main" ]]; then
    printf 'Refusing deployment because current branch is %s, not main\n' "$current_branch"
    write_state FAILED "$current_commit"
    exit 1
fi
write_state RUNNING "$current_commit"

deploy_mode=single-host
if [[ -f "$CONFIG_FILE" ]]; then
    configured_mode="$(awk -F= '$1 == "BYTEDEPTH_DEPLOY_MODE" {value=$2} END {print value}' "$CONFIG_FILE")"
    deploy_mode="${configured_mode:-$deploy_mode}"
fi

case "$deploy_mode" in
    single-host)
        compose_args=()
        ;;
    data-access)
        compose_args=(-f docker-compose.yml -f deploy/docker-compose.data-access.yml)
        ;;
    external-services)
        compose_args=(--env-file .env -f deploy/docker-compose.app-external.yml)
        ;;
    *)
        printf 'Refusing deployment because mode %s is not allowed\n' "$deploy_mode"
        write_state FAILED "$current_commit"
        exit 1
        ;;
esac

if git fetch --no-tags origin main && git merge --ff-only FETCH_HEAD \
    && docker compose "${compose_args[@]}" up --build -d; then
    write_state SUCCESS "$(git rev-parse --short HEAD)"
else
    write_state FAILED "$(git rev-parse --short HEAD)"
    exit 1
fi
