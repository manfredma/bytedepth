#!/usr/bin/env bash
set -Eeuo pipefail

readonly DEPLOY_ROOT=/opt/bytedepth
readonly STATE_DIR=/var/lib/bytedepth-deploy
readonly STATE_FILE="$STATE_DIR/status"
readonly LOG_FILE=/var/log/bytedepth-deploy.log
readonly ARTIFACT_ROOT=/opt/bytedepth/incoming

write_state() {
    local state="$1"
    local version="$2"
    local commit="$3"
    local temporary
    mkdir -p "$STATE_DIR"
    temporary="$(mktemp "$STATE_DIR/status.XXXXXX")"
    printf 'state=%s\nupdated_at=%s\nversion=%s\ncommit=%s\n' \
        "$state" "$(date -u +%FT%TZ)" "$version" "$commit" > "$temporary"
    chmod 0600 "$temporary"
    mv "$temporary" "$STATE_FILE"
}

mkdir -p "$STATE_DIR"
touch "$LOG_FILE"
exec >> "$LOG_FILE" 2>&1

release_tag="${BYTEDEPTH_RELEASE_TAG:-}"
if [[ ! "$release_tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
    printf 'Refusing deployment because BYTEDEPTH_RELEASE_TAG is invalid\n'
    write_state FAILED "" ""
    exit 1
fi
artifact_dir="$ARTIFACT_ROOT/$release_tag"
if [[ ! -f "$artifact_dir/app.jar" || ! -f "$artifact_dir/artifact.manifest" ]]; then
    printf 'Refusing deployment because no pre-uploaded artifact exists for %s\n' "$release_tag"
    write_state FAILED "$release_tag" ""
    exit 1
fi
write_state RUNNING "$release_tag" ""

if "$DEPLOY_ROOT/deploy/deploy-production.sh" --artifact "$artifact_dir/app.jar" --manifest "$artifact_dir/artifact.manifest" "$release_tag"; then
    write_state SUCCESS "$release_tag" "$(awk -F= '$1 == "commit" {print $2; exit}' "$artifact_dir/artifact.manifest")"
else
    write_state FAILED "$release_tag" "$(awk -F= '$1 == "commit" {print $2; exit}' "$artifact_dir/artifact.manifest")"
    exit 1
fi
