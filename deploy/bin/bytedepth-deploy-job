#!/usr/bin/env bash
set -Eeuo pipefail

readonly DEPLOY_ROOT=/opt/bytedepth
readonly STATE_DIR=/var/lib/bytedepth-deploy
readonly STATE_FILE="$STATE_DIR/status"
readonly LOG_FILE=/var/log/bytedepth-deploy.log
readonly GIT_REMOTE_URL=git@github.com:manfredma/bytedepth.git

write_state() {
    local state="$1"
    local version="$2"
    local commit="$3"
    local temporary
    mkdir -p "$STATE_DIR"
    temporary="$(mktemp "$STATE_DIR/status.XXXXXX")"
    printf 'state=%s\nupdated_at=%s\nversion=%s\ncommit=%s\n' \
        "$state" "$(date -u +%FT%TZ)" "$version" "$commit" > "$temporary"
    chmod 0600 "$temporary"
    mv "$temporary" "$STATE_FILE"
}

mkdir -p "$STATE_DIR"
touch "$LOG_FILE"
exec >> "$LOG_FILE" 2>&1

cd "$DEPLOY_ROOT"
git_cmd() { git -c safe.directory="$DEPLOY_ROOT" "$@"; }
current_commit="$(git_cmd rev-parse --short HEAD)"
origin_url="$(git_cmd remote get-url origin)"
if [[ "$origin_url" != "$GIT_REMOTE_URL" ]]; then
    printf 'Refusing deployment because origin is %s, expected %s\n' "$origin_url" "$GIT_REMOTE_URL"
    write_state FAILED "" "$current_commit"
    exit 1
fi
release_tag="${BYTEDEPTH_RELEASE_TAG:-}"
if [[ ! "$release_tag" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
    printf 'Refusing deployment because BYTEDEPTH_RELEASE_TAG is invalid\n'
    write_state FAILED "" "$current_commit"
    exit 1
fi
write_state RUNNING "$release_tag" "$current_commit"

if ./deploy/deploy-release.sh "$release_tag"; then
    write_state SUCCESS "$release_tag" "$(git_cmd rev-parse --short HEAD)"
else
    write_state FAILED "$release_tag" "$(git_cmd rev-parse --short HEAD)"
    exit 1
fi
